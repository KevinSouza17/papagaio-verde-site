# Escolha: neon | supabase | local | postgres
DB_PROVIDER=neon

# PostgreSQL: Neon, Supabase (connection string do pooler/host) ou local.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BASE?sslmode=verify-full
DATABASE_SSL=verify-full
DATABASE_POOL_MAX=5

# Para PostgreSQL local, use:
# DB_PROVIDER=local
# DATABASE_URL=postgresql://papagaio_app:SENHA@127.0.0.1:5432/papagaio_verde
# DATABASE_SSL=disable

# Identificação exclusiva do administrador. Pode ser CNPJ ou e-mail.
# ADMIN_EMAIL mantém compatibilidade com a configuração anterior.
ADMIN_LOGIN=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Gere um segredo aleatório longo e exclusivo para assinar sessões.
SESSION_SECRET=
