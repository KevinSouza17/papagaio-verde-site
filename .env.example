# Copie este arquivo para .env.local e preencha os valores.
# Nunca envie .env.local ao GitHub.

# Nuvem (Neon): use a connection string do projeto e mantenha verify-full.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BASE?sslmode=verify-full
DATABASE_SSL=verify-full

# PostgreSQL local (substitua as duas linhas acima):
# DATABASE_URL=postgresql://papagaio_app:SENHA@127.0.0.1:5432/papagaio_verde
# DATABASE_SSL=disable

DATABASE_POOL_MAX=5
SESSION_SECRET=gere-um-segredo-aleatorio-longo
ADMIN_EMAIL=
ADMIN_PASSWORD=
